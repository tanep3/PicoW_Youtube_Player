[Unit]
Description=Pico W YouTube video player (user)
# Retry binding the configured Pi address until networking is ready.
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/tane/dev/PicoW/PicoW_Youtube_Player
ExecStart=/usr/bin/python3 -m server.web --config /home/tane/dev/PicoW/PicoW_Youtube_Player/web-config.json
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=3
# Run the application's KeyboardInterrupt/finally cleanup on a normal stop.
KillSignal=SIGINT
TimeoutStopSec=10
UMask=0077

[Install]
WantedBy=default.target
