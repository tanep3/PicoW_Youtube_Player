+static size_t diag_safe_rx_len(cyw43_int_t *self, const uint8_t *ptr, size_t reported) {
+    // A malformed SDPCM header can report an excessive length. Never let the
+    // diagnostic parser read outside the driver's fixed SPI buffer.
+    uintptr_t base = (uintptr_t)self->spid_buf;
+    uintptr_t at = (uintptr_t)ptr;
+    if (at < base || at >= base + sizeof(self->spid_buf)) return 0;
+    size_t available = sizeof(self->spid_buf) - (size_t)(at - base);
+    return reported < available ? reported : available;
+}
+
+size_t cyw43_diag_bound_eth(void *ll, const uint8_t *frame, size_t reported) {
+    return diag_safe_rx_len(CYW_INT_FROM_LL((cyw43_ll_t *)ll), frame, reported);
+}
